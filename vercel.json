{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node scripts/finalize-seo-origin.mjs",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/_remote/framerusercontent.com/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/_remote/fonts.gstatic.com/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}